# Paths used by the native, non-Docker installation.
SUB2API_INSTALL_ROOT=/opt/sub2api
SUB2API_CONFIG_ROOT=/etc/sub2api
SUB2API_STATE_ROOT=/var/lib/sub2api-weekly-overdraft
SUB2API_BINARY=/opt/sub2api/sub2api
SUB2API_HEALTH_URL=http://127.0.0.1/health

# PostgreSQL connection used for pg_dump, clone migration validation and rollback.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_PASSWORD=change-me
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable

# Release tracking. Source fusion and compilation happen only in GitHub Actions.
# The production monitor queries the official project and the builder repository.
SUB2API_OFFICIAL_REPOSITORY=Wei-Shaw/sub2api
SUB2API_BUILDER_REPOSITORY=kiasd/sub2api-overdraft-auto-builder

# The timer only monitors GitHub Actions and verified Releases. A token is not
# required at the default 3-5 hour interval. Set one locally only when a private
# repository or a higher API rate limit is required.
SUB2API_RELEASE_MONITOR_TIMEOUT=900

# Apply policy. Candidate validation happens in Actions; the server backs up
# native program/config/database state before the user-approved atomic switch.
SUB2API_HEALTH_TIMEOUT_SECONDS=120
