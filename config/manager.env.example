# Paths used by the native, non-Docker installation.
SUB2API_INSTALL_ROOT=/opt/sub2api
SUB2API_CONFIG_ROOT=/etc/sub2api
SUB2API_STATE_ROOT=/var/lib/sub2api-weekly-overdraft
SUB2API_BINARY=/opt/sub2api/sub2api
SUB2API_HEALTH_URL=http://127.0.0.1/health

# Build tools. pnpm 9.x is the upstream-pinned version; pnpm 10.x is also accepted.
SUB2API_GO=go
SUB2API_PNPM=pnpm
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn

# PostgreSQL connection used for pg_dump, clone migration validation and rollback.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_PASSWORD=change-me
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable

# Source tracking. Official releases are the default base. The Fork branch is
# retained as a provenance/reference channel; overdraft builds replay a
# versioned patch onto the official source in a temporary Git worktree.
SUB2API_OFFICIAL_REPOSITORY=Wei-Shaw/sub2api
SUB2API_FORK_REPOSITORY=DeanZFC/sub2api-overdraft
SUB2API_FORK_BRANCH=codex-overdraft
SUB2API_PATCH_DIR=/opt/sub2api/plugins/weekly-overdraft/patches
SUB2API_UI_OVERLAY_DIR=/opt/sub2api/plugins/weekly-overdraft/payload/ui

# Upgrade policy. Full frontend tests are the safe default.
SUB2API_FULL_FRONTEND_TESTS=1
SUB2API_HEALTH_TIMEOUT_SECONDS=120
SUB2API_KEEP_FAILED_WORK=0
