[Unit]
Description=Monitor and stage a verified Sub2API GitHub Release
Wants=network-online.target
After=network-online.target sub2api.service
ConditionPathExists=/opt/sub2api/plugins/weekly-overdraft/release_monitor.py

[Service]
Type=oneshot
User=root
ExecStart=/opt/sub2api/plugins/weekly-overdraft/release_monitor.py
EnvironmentFile=-/etc/sub2api/weekly-overdraft-manager.env
TimeoutStartSec=900
NoNewPrivileges=false
