+
+	cyber := &openAIWSDialError{
+		StatusCode:   http.StatusForbidden,
+		ResponseBody: []byte(`{"error":{"code":"cyber_policy","message":"blocked"}}`),
+	}
+	require.False(t, isOpenAICindyHTTPToWSV2HandshakeForbidden(cyber))
+}
