+### CPUID Hypervisor Bit
+
+```c
+int regs[4];
+__cpuid(regs, 1);
+if (regs[2] & (1 << 31)) {  // ECX bit 31 = hypervisor present
+    exit(1);
+}
+
+// Hypervisor brand string
+__cpuid(regs, 0x40000000);
+char brand[13] = {0};
+memcpy(brand, &regs[1], 12);
+// "VMwareVMware", "Microsoft Hv", "KVMKVMKVM", "XenVMMXenVMM"
+```
