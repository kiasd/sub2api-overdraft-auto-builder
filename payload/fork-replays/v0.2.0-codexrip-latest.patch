+	require.False(t, shouldRetryOpenAIWSIngressTurn(1, 0, wroteOutput))
+	require.True(t, shouldRetryOpenAIWSIngressTurn(1, 0, persistent), "首轮零输出的持久网络错误也应同账号重试一次")
+}
