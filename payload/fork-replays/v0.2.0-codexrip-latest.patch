+	}
+	for alias, live := range map[string]string{
+		"gpt-5.4-mini": "openai/gpt-5.6-luna",
+	} {
+		prepared, err := prepareOpenAIInputTokensCountRequest(
+			[]byte(`{"model":"`+alias+`","messages":[{"role":"user","content":"hi"}]}`),
+			account,
+			"unrelated-default",
