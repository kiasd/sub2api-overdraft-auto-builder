+## 网络流量分析
+
+```bash
+# Wireshark 过滤
+http.request.method == "POST"
+dns.qry.name contains "evil"
+tcp.flags.syn == 1 && tcp.flags.ack == 0  # SYN 扫描
+frame contains "password"
+
+# tshark 命令行
+tshark -r capture.pcap -T fields -e ip.dst -e tcp.dstport | sort | uniq -c | sort -rn
+tshark -r capture.pcap -Y "http" -T fields -e http.host -e http.request.uri
+tshark -r capture.pcap -Y "dns" -T fields -e dns.qry.name | sort -u
+
+# 提取文件
+tcpflow -r capture.pcap
+# Wireshark: File → Export Objects → HTTP/SMB
+
+# C2 流量特征
+# - 周期性心跳 (Beaconing)
+# - 固定 User-Agent
+# - 异常域名/IP
+# - 加密但无证书的 HTTPS
+# - DNS 隧道 (长子域名查询)
+```
+
+---
+
+## IoC (威胁指标) 提取
+
+```python
+import re
+
+def extract_iocs(text):
+    iocs = {
+        "ipv4": [],
+        "domain": [],
+        "url": [],
+        "md5": [],
+        "sha256": [],
+        "email": []
+    }
+    
+    # IP (排除私有/保留)
+    ips = re.findall(r'\b(?!10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)(?:\d{1,3}\.){3}\d{1,3}\b', text)
+    iocs["ipv4"] = list(set(ips))
+    
+    # 域名
+    domains = re.findall(r'\b(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}\b', text, re.I)
+    iocs["domain"] = list(set(domains))
+    
+    # URL
+    urls = re.findall(r'https?://[^\s<>"{}|\\^`\[\]]+', text)
+    iocs["url"] = list(set(urls))
+    
+    # 哈希
+    iocs["md5"] = list(set(re.findall(r'\b[a-f0-9]{32}\b', text, re.I)))
+    iocs["sha256"] = list(set(re.findall(r'\b[a-f0-9]{64}\b', text, re.I)))
+    
+    # 邮箱
+    iocs["email"] = list(set(re.findall(r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b', text)))
+    
+    return iocs
+
+# 去偏转 (defang) 处理
+def defang(ioc):
+    return ioc.replace(".", "[.]").replace("http", "hxxp")
+
+def refang(ioc):
+    return ioc.replace("[.]", ".").replace("hxxp", "http")
+```
