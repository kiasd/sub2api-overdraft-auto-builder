+# 恶意样本分析参考
+
+## 静态分析
+
+### 基本信息提取
+
+```bash
+# 文件类型与哈希
+file sample
+md5sum sample && sha256sum sample
+# 查 VirusTotal: https://www.virustotal.com/
+
+# PE 文件信息
+pestudio sample.exe          # GUI 综合分析
+pecheck sample.exe           # 命令行
+diec sample.exe              # Detect-It-Easy 查壳/编译器
+
+# 字符串提取
+strings -a -n 8 sample       # ASCII
+strings -a -n 8 -e l sample  # Unicode
+floss sample.exe             # FLARE FLOSS 解混淆字符串
+
+# 熵值分析（高熵=压缩/加密）
+python3 -c "
+import math, sys
+data = open(sys.argv[1],'rb').read()
+freq = {}
+for b in data: freq[b] = freq.get(b,0)+1
+entropy = -sum((c/len(data))*math.log2(c/len(data)) for c in freq.values())
+print(f'Entropy: {entropy:.2f}')
+" sample.exe
+```
+
+### Python 静态分析
+
+```python
+import pefile
+import hashlib
+
+pe = pefile.PE("sample.exe")
+
+# 基本信息
+print(f"Machine: {hex(pe.FILE_HEADER.Machine)}")
+print(f"Timestamp: {pe.FILE_HEADER.TimeDateStamp}")
+print(f"Entry Point: {hex(pe.OPTIONAL_HEADER.AddressOfEntryPoint)}")
+
+# 节区分析
+for section in pe.sections:
+    name = section.Name.decode().strip('\x00')
+    entropy = section.get_entropy()
+    print(f"{name}: VA={hex(section.VirtualAddress)} "
+          f"Size={section.SizeOfRawData} Entropy={entropy:.2f}")
+    if entropy > 7.0:
+        print(f"  ⚠ 高熵，可能加壳/加密")
+
+# 导入表分析
+suspicious_apis = {
+    "VirtualAlloc", "VirtualProtect", "WriteProcessMemory",
+    "CreateRemoteThread", "NtUnmapViewOfSection",
+    "RegSetValueEx", "CryptEncrypt", "InternetOpen",
+    "WSAStartup", "connect", "CreateService"
+}
+for entry in pe.DIRECTORY_ENTRY_IMPORT:
+    dll = entry.dll.decode()
+    for imp in entry.imports:
+        if imp.name and imp.name.decode() in suspicious_apis:
+            print(f"⚠ 可疑 API: {dll}!{imp.name.decode()}")
+
+# 资源提取
+if hasattr(pe, 'DIRECTORY_ENTRY_RESOURCE'):
+    for resource_type in pe.DIRECTORY_ENTRY_RESOURCE.entries:
+        for resource_id in resource_type.directory.entries:
+            for resource_lang in resource_id.directory.entries:
+                data = pe.get_data(
+                    resource_lang.data.struct.OffsetToData,
+                    resource_lang.data.struct.Size
+                )
+                with open(f"resource_{resource_lang.data.struct.OffsetToData}.bin", "wb") as f:
+                    f.write(data)
+```
+
+### YARA 规则编写
+
+```yara
+rule Ransomware_Generic {
+    meta:
+        author = "analyst"
+        description = "Generic ransomware detection"
+        
+    strings:
+        // 文件操作
+        $enc_ext1 = ".encrypted" ascii nocase
+        $enc_ext2 = ".locked" ascii nocase
+        $ransom_note = "YOUR FILES HAVE BEEN ENCRYPTED" ascii nocase
+        
+        // 加密相关 API
+        $api1 = "CryptEncrypt" ascii
+        $api2 = "CryptGenKey" ascii
+        
+        // 影卷删除
+        $vss = "vssadmin delete shadows" ascii nocase
+        $wbadmin = "wbadmin delete catalog" ascii nocase
+        
+        // 网络 C2
+        $tor = ".onion" ascii
+        
+    condition:
+        uint16(0) == 0x5A4D and  // MZ 头
+        (2 of ($enc_ext*, $ransom_note)) and
+        (1 of ($api*)) and
+        (1 of ($vss, $wbadmin))
+}
+
+rule Suspicious_Shellcode {
+    strings:
+        // x64 常见 shellcode 模式
+        $egg1 = { 48 31 C0 }           // xor rax, rax
+        $egg2 = { 48 8B 05 }           // mov rax, [rip+offset]
+        $find_kernel32 = { 64 48 8B 04 25 60 00 00 00 }  // mov rax, gs:[0x60]
+        
+    condition:
+        all of them
+}
+
+// 运行 YARA
+// yara rule.yar sample.exe
+// yara -r rule.yar /path/to/scan/  # 递归扫描
+```
