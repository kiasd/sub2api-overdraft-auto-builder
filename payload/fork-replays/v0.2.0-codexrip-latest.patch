+  it('shows an explicit retry state without inventing counts', async () => {
+    const wrapper = mount(AccountFolderBar, {
+      props: { folders: [], activeFolder: '', error: true }
+    })
+    const retry = wrapper.get('[data-test="desktop-taxonomy-retry"]')
