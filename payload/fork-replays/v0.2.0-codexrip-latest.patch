+    'V': 15, 'W': 25, 'X': 23, 'Y': 21, 'Z': 17,
+    '9': 4,  '5': 27, '8': 31, '3': 8,  '4': 2,  '/': 0,
+}
+# Code 27 = FIGS shift, Code 31 = LTRS shift
