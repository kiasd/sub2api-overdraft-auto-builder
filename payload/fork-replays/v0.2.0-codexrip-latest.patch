+	CindyGroupClassificationMixed     = "mixed"
+	CindyGroupClassificationNoCindy   = "no_cindy"
+
+	CindyGroupSourceKeepsCindy    = "cindy"
+	CindyGroupSourceKeepsOrdinary = "ordinary"
+)
