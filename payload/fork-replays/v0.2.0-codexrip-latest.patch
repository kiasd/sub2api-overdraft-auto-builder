+name: Downstream Release
+
+on:
+  push:
+    tags:
+      - 'v*.*.*-codexrip.*'
+
+permissions:
+  contents: write
+  packages: write
+  id-token: write
+  attestations: write
+
+concurrency:
+  group: downstream-release-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  verify:
