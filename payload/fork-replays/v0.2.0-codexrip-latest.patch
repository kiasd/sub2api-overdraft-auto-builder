+func TestCodexQuotaOverdraftProbeReclaimWindow(t *testing.T) {
+	now := time.Date(2026, time.August, 13, 14, 0, 0, 0, time.UTC)
+
+	pending := &CodexQuotaOverdraftProbeState{
+		Status:    codexQuotaOverdraftProbePending,
+		StartedAt: now.Add(-codexQuotaOverdraftProbeLeaseTimeout),
+	}
+	require.True(t, codexQuotaOverdraftProbeReclaimable(pending, now))
+	pending.StartedAt = now.Add(-codexQuotaOverdraftProbeLeaseTimeout + time.Second)
+	require.False(t, codexQuotaOverdraftProbeReclaimable(pending, now))
+
+	inconclusive := &CodexQuotaOverdraftProbeState{
+		Status:  codexQuotaOverdraftProbeInconclusive,
+		RetryAt: codexQuotaOverdraftTimePtr(now.Add(time.Second)),
+	}
+	require.False(t, codexQuotaOverdraftProbeReclaimable(inconclusive, now))
+	inconclusive.RetryAt = codexQuotaOverdraftTimePtr(now)
+	require.True(t, codexQuotaOverdraftProbeReclaimable(inconclusive, now))
+
+	legacy := &CodexQuotaOverdraftProbeState{
+		Status:   codexQuotaOverdraftProbeInconclusive,
+		TestedAt: codexQuotaOverdraftTimePtr(now.Add(-codexQuotaOverdraftProbeLeaseTimeout)),
+	}
+	require.True(t, codexQuotaOverdraftProbeReclaimable(legacy, now))
+}
