+curl -s "https://{TARGET}/package-lock.json" 2>/dev/null | jq 'keys' 
+
+# GitHub搜索私有包名
+# 搜索: "@internal-company/" site:github.com
+
+# 从错误页面/源码注释发现
+curl -s "https://{TARGET}" | grep -oE "@[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+"
