+            {{ t('admin.accounts.cindy.duplicateOwner', { id: cluster.proposed_owner_id || '-' }) }}
+          </span>
+        </div>
+        <p class="mt-1 break-words text-gray-500 dark:text-dark-300">
+          {{ t('admin.accounts.cindy.duplicateOthers', { ids: cluster.other_account_ids.join(', ') }) }}
+        </p>
