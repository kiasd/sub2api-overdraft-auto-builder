+const (
+	AccountJobKindImportData             = "account_import"
+	AccountJobKindImportCodex            = "account_import_codex"
+	AccountJobKindBatchCreate            = "account_batch_create"
+	AccountJobKindBulkUpdate             = "account_bulk_update"
