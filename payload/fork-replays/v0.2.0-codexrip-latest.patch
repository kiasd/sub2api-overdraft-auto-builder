+	t.Run("conflicting hits", func(t *testing.T) {
+		lookup := LookupCindyOpaqueContinuationBinding(
+			context.Background(),
+			&cindyOpaqueBindingLookupStore{accountIDs: map[string]int64{"a_hit": 731, "z_hit": 732}},
+			17,
+			[]string{"z_hit", "a_hit"},
