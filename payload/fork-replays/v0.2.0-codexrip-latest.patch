+		},
+		"partial response": func(client *fakeRemoteSkillHTTPClient) {
+			client.contentLength[RemoteSkillMoxinggangPath+"/RULES.md"] = int64(len(client.responses[RemoteSkillMoxinggangPath+"/RULES.md"]) + 1)
+		},
