+		require.NoError(t, err)
+		require.Equal(t, live, prepared.BillingModel, alias)
+		require.Equal(t, live, prepared.UpstreamModel, alias)
+		require.Equal(t, live, prepared.Request.Model, alias)
+	}
+}
