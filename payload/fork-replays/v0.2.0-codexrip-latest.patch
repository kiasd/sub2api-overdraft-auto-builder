+            (r"\b(?:esolang|brainfuck|encoding chain|unicode puzzle)\b|编码链|二维码|脑洞", 3),
+            (r"\b(?:rf|sdr|iq samples?|qam|radio)\b|无线电|信号处理", 4),
+            (r"custom game|custom vm|constraint solving|\bz3\b|博弈|约束求解", 3),
+            (r"\bctfd\b", 2),
+        ),
+        ((".iq", 5),),
