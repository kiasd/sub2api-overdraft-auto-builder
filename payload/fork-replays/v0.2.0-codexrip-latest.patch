+func requireCompleteCodexModelsHandlerResponse(t *testing.T, recorder *httptest.ResponseRecorder, slug string) {
+	t.Helper()
+	manifestSlugs := codexHandlerManifestSlugs(t, recorder)
+	foundSlug := false
