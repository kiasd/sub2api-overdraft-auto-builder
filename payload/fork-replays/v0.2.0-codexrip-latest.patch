+function normalizeOpenAIRefusalKeywordForComparison(value: string): string {
+  return value
+    .normalize("NFKC")
+    .replace(/[‘’‚‛]/gu, "'")
+    .replace(/[“”„‟]/gu, '"')
+    .toLocaleLowerCase()
+    .replace(/\s+/gu, " ")
+    .trim();
