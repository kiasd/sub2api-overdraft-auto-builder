+func (r *openAIRefusalFlushRecorder) Write(payload []byte) (int, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.body.Write(payload)
+}
+
+func (r *openAIRefusalFlushRecorder) Flush() {
+	select {
+	case r.flushed <- struct{}{}:
+	default:
+	}
+}
