+		SettingKeyOpenAIAPIKeyPromptCacheKeyNormalizationEnabled: "true",
+		SettingKeyOpenAIRefusalRewriteEnabled:                    "false",
+		SettingKeyOpenAIRefusalKeywords:                          `["cannot"]`,
+		SettingKeyOpenAIRefusalReplacement:                       "continue current task",
