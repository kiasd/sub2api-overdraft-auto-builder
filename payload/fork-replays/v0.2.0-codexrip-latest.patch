+type cindyBalancePendingStoreStub struct {
+	*stubGatewayCache
+	mu           sync.Mutex
+	pending      map[int64]bool
+	fingerprints map[int64]string
+	hasErr       error
+	getErr       error
+	clearErr     error
+	hasCalls     int
+	getCalls     int
+	clearCalls   int
+	lastBatch    int
