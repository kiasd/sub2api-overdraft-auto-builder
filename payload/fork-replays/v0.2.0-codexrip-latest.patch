+	mock.ExpectQuery("WITH candidate AS[\\s\\S]+COUNT\\(\\*\\).*status = 'running'.*< 2[\\s\\S]+active.created_by = pending.created_by[\\s\\S]+active.kind = pending.kind[\\s\\S]+FOR UPDATE SKIP LOCKED").
