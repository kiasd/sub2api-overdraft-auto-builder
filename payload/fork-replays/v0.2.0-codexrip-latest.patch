+	svc := &SettingService{settingRepo: repo}
+
+	initial := svc.GetOpenAIRefusalRecoveryRuntime(context.Background())
+
+	require.False(t, initial.Enabled)
+	require.False(t, initial.CyberFailoverEnabled())
