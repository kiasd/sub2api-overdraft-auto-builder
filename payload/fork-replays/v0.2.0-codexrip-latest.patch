+```python
+from math import gcd
+for n_a in collected:
+    for n_b in collected:
+        if n_a == n_b: continue
+        p = gcd(n_a, n_b)
+        if 1 < p < n_a:
+            q = n_a // p
+            d = pow(e + 2, -1, (p-1)*(q-1))  # NMC-style
+            break
+```
