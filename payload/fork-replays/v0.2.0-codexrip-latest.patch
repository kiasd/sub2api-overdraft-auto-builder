+	require.False(t, search.PublicModel)
+	require.Equal(t, []CindyEndpoint{CindyEndpointAlphaSearch}, search.VerifiedEndpoints)
+	require.Equal(t, CindyFreeModelCatalogSourceRevision, search.MetadataSourceRevision)
