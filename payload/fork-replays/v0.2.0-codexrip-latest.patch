+func TestAccountJobRepositoryReserveCapsBatchAtOneHundred(t *testing.T) {
+	repo, mock := newAccountJobRepoTest(t)
+	mock.ExpectBegin()
+	mock.ExpectQuery("WITH picked AS[\\s\\S]+LIMIT \\$2[\\s\\S]+UPDATE admin_account_job_items").
