+		return nil, err
+	}
+	item.Status = service.ImageStudioItemStatus(status)
+	if errorCode.Valid {
+		item.ErrorCode = errorCode.String
+	}
+	if errorMessage.Valid {
+		item.ErrorMessage = errorMessage.String
+	}
+	if started.Valid {
+		item.StartedAt = &started.Time
+	}
+	if finished.Valid {
+		item.FinishedAt = &finished.Time
+	}
