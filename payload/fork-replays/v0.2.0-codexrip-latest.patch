+	body := []byte(`{"model":"openai/gpt-5.6-luna","store":false,"previous_response_id":"resp_legacy","input":[{"type":"reasoning","id":"rs_legacy","encrypted_content":"cipher","phase":"analysis"}]}`)
+	account := cindyHTTPToWSV2TestAccount()
