+void filter(char *input) {
+    int8_t len = (int8_t)strlen(input);  // truncates at 255 → wraps to -1 or 0
+    for (int8_t i = 0; i <= len; i++) {  // at len==-1 (255 cast): 0 <= -1 is false
+        if (!islower(input[i]))
+            reject();
+    }
+}
+```
