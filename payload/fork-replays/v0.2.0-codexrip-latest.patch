+	require.Equal(t, "paused", job.Status)
+	claim, err := repo.ClaimJob(ctx, "paused-job-must-not-run", time.Now().UTC().Add(time.Minute))
+	require.NoError(t, err)
+	require.Nil(t, claim)
+
