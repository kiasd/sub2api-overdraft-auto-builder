+
+	const retryLimit = 5
+	var wg sync.WaitGroup
+	claimed := make(chan bool, 100)
+	for i := 0; i < cap(claimed); i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, ok := state.take(99, retryLimit)
+			claimed <- ok
+		}()
+	}
