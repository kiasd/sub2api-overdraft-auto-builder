@@ -0,0 +1,48 @@
+package service
+
+import (
+	"testing"
+	"time"
+)
+
+func TestPredictOpenAIQuotaUsesRecentRate(t *testing.T) {
+	now := time.Unix(1_700_000_000, 0).UTC()
+	prediction := PredictOpenAIQuota(
+		&OpenAIRateLimitWindow{UsedPercent: 80, ResetAt: now.Add(2 * time.Hour).Unix()},
+		[]OpenAIQuotaPredictionSnapshot{
+			{At: now.Add(-time.Hour), UsedPercent: 60},
+			{At: now, UsedPercent: 80},
+		},
+		now,
+	)
+	if prediction.ConsumptionPercentPerHour != 20 {
+		t.Fatalf("rate = %v, want 20", prediction.ConsumptionPercentPerHour)
+	}
+	if prediction.RemainingPercent != 20 {
+		t.Fatalf("remaining = %v, want 20", prediction.RemainingPercent)
+	}
+	if prediction.Status != "available" {
+		t.Fatalf("status = %q, want available", prediction.Status)
+	}
+}
+
+func TestPredictOpenAIQuotaDoesNotInventRate(t *testing.T) {
+	now := time.Unix(1_700_000_000, 0).UTC()
+	prediction := PredictOpenAIQuota(&OpenAIRateLimitWindow{UsedPercent: 100}, nil, now)
+	if prediction.ConsumptionPercentPerHour != 0 || prediction.EstimatedDepletionAt != nil {
+		t.Fatalf("prediction invented a rate: %+v", prediction)
+	}
+	if prediction.Status != "exhausted" {
+		t.Fatalf("status = %q, want exhausted", prediction.Status)
+	}
+}
+
+func TestSelectMostConstrainedWindow(t *testing.T) {
+	usage := &OpenAIQuotaUsage{RateLimit: &OpenAIRateLimit{
+		PrimaryWindow:   &OpenAIRateLimitWindow{UsedPercent: 30},
+		SecondaryWindow: &OpenAIRateLimitWindow{UsedPercent: 90},
+	}}
+	if got := SelectMostConstrainedWindow(usage); got == nil || got.UsedPercent != 90 {
+		t.Fatalf("selected window = %+v, want 90%% used", got)
+	}
+}
