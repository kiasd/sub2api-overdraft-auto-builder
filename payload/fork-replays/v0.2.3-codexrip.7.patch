+
+type codexQuotaOverdraftSettingRepoStub struct {
+	values map[string]string
+}
+
+func (r *codexQuotaOverdraftSettingRepoStub) Get(context.Context, string) (*Setting, error) {
+	return nil, ErrSettingNotFound
+}
+
+func (r *codexQuotaOverdraftSettingRepoStub) GetValue(_ context.Context, key string) (string, error) {
+	if value, ok := r.values[key]; ok {
+		return value, nil
+	}
+	return "", ErrSettingNotFound
+}
+
+func (r *codexQuotaOverdraftSettingRepoStub) Set(_ context.Context, key, value string) error {
+	if r.values == nil {
+		r.values = make(map[string]string)
+	}
+	r.values[key] = value
+	return nil
+}
+
+func (r *codexQuotaOverdraftSettingRepoStub) GetMultiple(_ context.Context, keys []string) (map[string]string, error) {
+	values := make(map[string]string, len(keys))
+	for _, key := range keys {
+		if value, ok := r.values[key]; ok {
+			values[key] = value
+		}
+	}
+	return values, nil
+}
+
+func (r *codexQuotaOverdraftSettingRepoStub) SetMultiple(_ context.Context, updates map[string]string) error {
+	if r.values == nil {
+		r.values = make(map[string]string)
+	}
+	for key, value := range updates {
+		r.values[key] = value
+	}
+	return nil
+}
+
+func (r *codexQuotaOverdraftSettingRepoStub) GetAll(context.Context) (map[string]string, error) {
+	values := make(map[string]string, len(r.values))
+	for key, value := range r.values {
+		values[key] = value
+	}
+	return values, nil
+}
+
+func (r *codexQuotaOverdraftSettingRepoStub) Delete(_ context.Context, key string) error {
+	delete(r.values, key)
+	return nil
+}
+
+func TestCodexQuotaOverdraftSettingFallsBackToGatewayConfig(t *testing.T) {
+	t.Cleanup(func() { setCodexQuotaOverdraftEnabledFallback(false) })
+
+	repo := &codexQuotaOverdraftSettingRepoStub{values: map[string]string{}}
+	svc := NewSettingService(repo, &config.Config{
+		Gateway: config.GatewayConfig{CodexQuotaOverdraftEnabled: true},
+	})
+
+	require.NoError(t, svc.LoadCodexQuotaOverdraftEnabled(context.Background()))
+	require.True(t, CodexQuotaOverdraftEnabled())
+	require.NotContains(t, repo.values, SettingKeyCodexQuotaOverdraftEnabled)
+
+	settings, err := svc.GetAllSettings(context.Background())
+	require.NoError(t, err)
+	require.True(t, settings.CodexQuotaOverdraftEnabled)
+
+	repo.values[SettingKeyCodexQuotaOverdraftEnabled] = "false"
+	require.NoError(t, svc.LoadCodexQuotaOverdraftEnabled(context.Background()))
+	require.False(t, CodexQuotaOverdraftEnabled())
+
+	settings, err = svc.GetAllSettings(context.Background())
+	require.NoError(t, err)
+	require.False(t, settings.CodexQuotaOverdraftEnabled)
+}
+
+func TestCodexQuotaOverdraftSettingUpdatePublishesImmediately(t *testing.T) {
+	t.Cleanup(func() { setCodexQuotaOverdraftEnabledFallback(false) })
+
+	repo := &codexQuotaOverdraftSettingRepoStub{values: map[string]string{}}
+	svc := NewSettingService(repo, &config.Config{
+		Gateway: config.GatewayConfig{CodexQuotaOverdraftEnabled: true},
+	})
+	require.NoError(t, svc.LoadCodexQuotaOverdraftEnabled(context.Background()))
+	require.True(t, CodexQuotaOverdraftEnabled())
+
+	require.NoError(t, svc.UpdateSettings(context.Background(), &SystemSettings{
+		CodexQuotaOverdraftEnabled: false,
+	}))
+	require.Equal(t, "false", repo.values[SettingKeyCodexQuotaOverdraftEnabled])
+	require.False(t, CodexQuotaOverdraftEnabled())
+
+	require.NoError(t, svc.UpdateSettings(context.Background(), &SystemSettings{
+		CodexQuotaOverdraftEnabled: true,
+	}))
+	require.Equal(t, "true", repo.values[SettingKeyCodexQuotaOverdraftEnabled])
+	require.True(t, CodexQuotaOverdraftEnabled())
+}
+
+func TestCodexQuotaOverdraftExecutionGatesUseEffectiveRuntimeSetting(t *testing.T) {
+	t.Cleanup(func() { setCodexQuotaOverdraftEnabledFallback(false) })
+	setCodexQuotaOverdraftEnabledFromPersistedSetting(true)
+
+	account := &Account{
+		ID:       41,
+		Platform: PlatformOpenAI,
+		Type:     AccountTypeOAuth,
+		Extra: map[string]any{
+			"codex_5h_used_percent": 95,
+			"codex_5h_reset_at":     time.Now().Add(time.Hour).Format(time.RFC3339),
+		},
+	}
+	cfg := &config.Config{Gateway: config.GatewayConfig{CodexQuotaOverdraftEnabled: false}}
+	ctx := WithCodexQuotaOverdraftScheduling(context.Background())
+
+	gateway := &OpenAIGatewayService{cfg: cfg}
+	body := []byte(`{"input":[{"type":"message","role":"user"}]}`)
+	require.NotEqual(t, string(body), string(gateway.prepareCodexQuotaOverdraftBody(ctx, account, false, body)))
+
+	coordinator := &CodexQuotaOverdraftCoordinator{
+		accountRepo:  &codexOverdraftProbeRepoStub{},
+		httpUpstream: &queuedHTTPUpstream{},
+		cfg:          cfg,
+	}
+	require.True(t, coordinator.enabled())
+
+	accountTest := &AccountTestService{cfg: cfg}
+	require.True(t, accountTest.codexQuotaOverdraftTestEnabled(account))
+
+	setCodexQuotaOverdraftEnabledFromPersistedSetting(false)
+	require.False(t, CodexQuotaOverdraftSchedulingEnabled(ctx))
+	require.False(t, coordinator.enabled())
+	require.False(t, accountTest.codexQuotaOverdraftTestEnabled(account))
+}
