new file mode 100644
index 000000000..11428b745
--- /dev/null
+++ b/backend/internal/service/openai_quota_prediction.go
@@ -0,0 +1,126 @@
+package service
+
+import (
+	"sort"
+	"time"
+)
+
+// OpenAIQuotaPredictionSnapshot is a small, non-sensitive usage sample kept by
+// the predictor. Callers may persist these samples if predictions must survive
+// a process restart.
+type OpenAIQuotaPredictionSnapshot struct {
+	At          time.Time
+	UsedPercent float64
+}
+
+// OpenAIQuotaPrediction describes the most constrained active usage window.
+type OpenAIQuotaPrediction struct {
+	Window                    string     `json:"window"`
+	UsedPercent               float64    `json:"used_percent"`
+	RemainingPercent          float64    `json:"remaining_percent"`
+	ConsumptionPercentPerHour float64    `json:"consumption_percent_per_hour"`
+	EstimatedDepletionAt      *time.Time `json:"estimated_depletion_at,omitempty"`
+	ResetAt                   *time.Time `json:"reset_at,omitempty"`
+	Status                    string     `json:"status"`
+}
+
+// PredictOpenAIQuota estimates depletion from recent snapshots. A missing or
+// non-increasing history yields a truthful "unknown" rate instead of inventing
+// a forecast. Actual overdraft availability is reported separately by the
+// Codex quota-overdraft probe state and is not inferred from this estimate.
+func PredictOpenAIQuota(window *OpenAIRateLimitWindow, history []OpenAIQuotaPredictionSnapshot, now time.Time) OpenAIQuotaPrediction {
+	result := OpenAIQuotaPrediction{Window: "unknown", Status: "unknown"}
+	if window == nil {
+		return result
+	}
+	result.Window = "primary"
+	result.UsedPercent = clampPercent(window.UsedPercent)
+	result.RemainingPercent = 100 - result.UsedPercent
+	if window.ResetAt > 0 {
+		reset := time.Unix(window.ResetAt, 0).UTC()
+		result.ResetAt = &reset
+	}
+
+	rate := recentConsumptionRate(history)
+	result.ConsumptionPercentPerHour = rate
+	if rate > 0 && result.RemainingPercent > 0 {
+		depletion := now.UTC().Add(time.Duration(result.RemainingPercent / rate * float64(time.Hour)))
+		result.EstimatedDepletionAt = &depletion
+	}
+
+	switch {
+	case result.RemainingPercent <= 0:
+		result.Status = "exhausted"
+	default:
+		result.Status = "available"
+	}
+	return result
+}
+
+func (s *OpenAIQuotaService) recordPredictionSnapshot(accountID int64, sample OpenAIQuotaPredictionSnapshot) []OpenAIQuotaPredictionSnapshot {
+	if s == nil || accountID <= 0 {
+		return nil
+	}
+	s.predictionMu.Lock()
+	defer s.predictionMu.Unlock()
+	if s.predictionHistory == nil {
+		s.predictionHistory = make(map[int64][]OpenAIQuotaPredictionSnapshot)
+	}
+	history := append(s.predictionHistory[accountID], sample)
+	if len(history) > 8 {
+		history = history[len(history)-8:]
+	}
+	s.predictionHistory[accountID] = history
+	return append([]OpenAIQuotaPredictionSnapshot(nil), history...)
+}
+
+// SelectMostConstrainedWindow returns the active window with the least
+// remaining percentage. It is deliberately pure so scheduler and UI code use
+// identical selection semantics.
+func SelectMostConstrainedWindow(usage *OpenAIQuotaUsage) *OpenAIRateLimitWindow {
+	if usage == nil || usage.RateLimit == nil {
+		return nil
+	}
+	windows := make([]*OpenAIRateLimitWindow, 0, 2)
+	if usage.RateLimit.PrimaryWindow != nil {
+		windows = append(windows, usage.RateLimit.PrimaryWindow)
+	}
+	if usage.RateLimit.SecondaryWindow != nil {
+		windows = append(windows, usage.RateLimit.SecondaryWindow)
+	}
+	if len(windows) == 0 {
+		return nil
+	}
+	sort.SliceStable(windows, func(i, j int) bool {
+		return windows[i].UsedPercent > windows[j].UsedPercent
+	})
+	return windows[0]
+}
+
+func recentConsumptionRate(history []OpenAIQuotaPredictionSnapshot) float64 {
+	if len(history) < 2 {
+		return 0
+	}
+	samples := append([]OpenAIQuotaPredictionSnapshot(nil), history...)
+	sort.Slice(samples, func(i, j int) bool { return samples[i].At.Before(samples[j].At) })
+	first, last := samples[len(samples)-2], samples[len(samples)-1]
+	seconds := last.At.Sub(first.At).Seconds()
+	if seconds <= 0 {
+		return 0
+	}
+	delta := clampPercent(last.UsedPercent) - clampPercent(first.UsedPercent)
+	if delta <= 0 {
+		return 0
+	}
+	return delta * 3600 / seconds
+}
+
+func clampPercent(value float64) float64 {
+	if value < 0 {
+		return 0
+	}
+	if value > 100 {
+		return 100
+	}
+	return value
+}
