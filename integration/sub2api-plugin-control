#!/usr/bin/env bash
set -Eeuo pipefail

MANAGER=/opt/sub2api/plugins/weekly-overdraft/manager.sh
ENV_FILE=/etc/sub2api/weekly-overdraft-manager.env
STATE_ROOT=/var/lib/sub2api-weekly-overdraft
APPLY_UNIT=sub2api-overdraft-apply.service
CONTROL_LOCK_WAIT_SECONDS=30

if [[ "$EUID" -ne 0 ]]; then
  printf 'plugin control must run through sudo\n' >&2
  exit 1
fi
action="${1:-}"
if [[ "$action" == "apply-worker-failed" && "${2:-}" == "success" ]]; then
  [[ "$#" -eq 2 ]]
  exit 0
fi
if [[ ! -x "$MANAGER" || ! -r "$ENV_FILE" ]]; then
  printf 'weekly-overdraft manager is not installed\n' >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a
export HOME="$STATE_ROOT"
export XDG_CACHE_HOME="$STATE_ROOT/cache"
export PATH="/usr/local/bin:/usr/bin:/bin"
install -d -o sub2api -g sub2api -m 0750 "$HOME" "$XDG_CACHE_HOME"
cd "$STATE_ROOT"
# Lock the directory inode itself so the privileged controller never follows a
# lock-file symlink created by the service account.
exec 9<"$STATE_ROOT"

run_manager() {
  /usr/sbin/runuser --user sub2api --preserve-environment -- "$MANAGER" "$@"
}

acquire_control_lock() {
  local timeout="${1:-$CONTROL_LOCK_WAIT_SECONDS}"
  if ! flock --exclusive --timeout "$timeout" 9; then
    printf 'another plugin control operation is running\n' >&2
    return 1
  fi
}

try_control_lock() {
  flock --exclusive --nonblock 9
}

apply_unit_running() {
  local state
  state="$(systemctl show --property=ActiveState --value "$APPLY_UNIT" 2>/dev/null || true)"
  [[ "$state" == "activating" || "$state" == "active" || "$state" == "reloading" || "$state" == "deactivating" ]]
}

restart_is_healthy() {
  systemctl restart sub2api.service || return 1
  systemctl is-active --quiet sub2api.service || return 1
}

restart_with_fallback() {
  local rollback_upgrade="${1:-no}"
  if restart_is_healthy; then
    return
  fi
  # An upgrade start failure can happen before ExecStartPost stages rollback.
  if [[ "$rollback_upgrade" == "yes" ]]; then
    run_manager rollback previous --reason start_failure || true
  fi
  if restart_is_healthy; then
    return
  fi
  journalctl -u sub2api.service -n 80 --no-pager >&2
  return 1
}

start_apply_unit() {
  local release_tag="$1"
  local binary_sha256="$2"
  if apply_unit_running; then
    printf 'an apply task is already running\n' >&2
    return 1
  fi
  SUB2API_MANAGER_LOCK_TIMEOUT_SECONDS=15 run_manager queue-apply "$release_tag" "$binary_sha256"
  if ! systemctl --no-block start "$APPLY_UNIT"; then
    run_manager apply-start-failed || true
    printf 'failed to start the background apply task\n' >&2
    return 1
  fi
  printf '{"status":"accepted","unit":"%s"}\n' "$APPLY_UNIT"
}

case "$action" in
  status)
    [[ "$#" -eq 1 ]]
      exec /usr/sbin/runuser --user sub2api --preserve-environment -- "$MANAGER" "$action"
    ;;
  check-update)
    [[ "$#" -eq 1 ]]
    acquire_control_lock
    run_manager "$action"
    ;;
  auto-status)
    [[ "$#" -eq 1 ]]
    result="$(run_manager auto-status)"
    if apply_unit_running; then
      printf '%s\n' "$result"
      exit 0
    fi
    if printf '%s\n' "$result" | python3 -c 'import json,sys; value=json.load(sys.stdin).get("auto_update", {}); raise SystemExit(0 if value.get("status") in {"apply_queued", "applying", "restart_pending", "rollback_pending"} else 1)'; then
      if try_control_lock; then
        if apply_unit_running; then
          printf '%s\n' "$result"
        else
          run_manager reconcile-apply-status
        fi
      else
        printf '%s\n' "$result"
      fi
      exit 0
    fi
    printf '%s\n' "$result"
    ;;
  set-auto-update)
    [[ "$#" -eq 2 ]]
    [[ "$2" == "on" || "$2" == "off" ]]
    acquire_control_lock
    run_manager "$action" "$2"
    ;;
  auto-run)
    [[ "$#" -eq 1 ]]
    if ! try_control_lock; then
      run_manager auto-status
      exit 0
    fi
    if ! apply_unit_running; then
      run_manager reconcile-apply-status >/dev/null
    fi
    run_manager auto-run
    ;;
  apply-start)
    [[ "$#" -eq 3 ]]
    [[ "$2" =~ ^fusion-v[0-9]+\.[0-9]+\.[0-9]+-overdraft\.[0-9]+-[0-9a-f]{8}-[0-9a-f]{8}-u[0-9a-f]{8}$ ]]
    [[ "$3" =~ ^[0-9a-f]{64}$ ]]
    acquire_control_lock
    start_apply_unit "$2" "$3"
    ;;
  apply-queued)
    [[ "$#" -eq 1 ]]
    acquire_control_lock
    result="$(run_manager apply-prepared)"
    printf '%s\n' "$result"
    run_manager auto-apply-restart
    restart_with_fallback yes
    run_manager auto-finish
    ;;
  apply-worker-failed)
    [[ "$#" -ge 1 && "$#" -le 2 ]]
    acquire_control_lock
    run_manager apply-worker-failed "systemd 应用任务异常停止 (${2:-unknown})"
    ;;
  apply-prepared)
    [[ "$#" -eq 1 ]]
    acquire_control_lock
    result="$(run_manager auto-status)"
    identity="$(printf '%s\n' "$result" | python3 -c 'import json,sys; value=json.load(sys.stdin).get("auto_update", {}).get("prepared", {}); print(value.get("release_tag", ""), value.get("binary_sha256", ""))')"
    read -r release_tag binary_sha256 <<<"$identity"
    [[ "$release_tag" =~ ^fusion-v[0-9]+\.[0-9]+\.[0-9]+-overdraft\.[0-9]+-[0-9a-f]{8}-[0-9a-f]{8}-u[0-9a-f]{8}$ ]]
    [[ "$binary_sha256" =~ ^[0-9a-f]{64}$ ]]
    start_apply_unit "$release_tag" "$binary_sha256"
    ;;
  rollback)
    [[ "$#" -eq 1 ]]
    acquire_control_lock
    run_manager rollback previous
    restart_with_fallback
    ;;
  enable-overdraft)
    [[ "$#" -eq 2 && ( "$2" == "on" || "$2" == "off" ) ]]
    acquire_control_lock
    run_manager enable-overdraft "$2"
    restart_with_fallback
    ;;
  *)
    printf 'unsupported plugin action\n' >&2
    exit 2
    ;;
esac
